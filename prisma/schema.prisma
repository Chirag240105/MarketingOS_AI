generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  emailVerified    DateTime?         @map("email_verified")
  name             String?
  image            String?
  password         String?
  role             UserRole          @default(USER)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  accounts         Account[]
  aiUsage          AIUsage[]
  approvals        Approval[]
  auditLogs        AuditLog[]
  campaignHistory  CampaignHistory[]
  createdCampaigns Campaign[]        @relation("CampaignCreator")
  memberships      Membership[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Workspace {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  description       String?
  logo              String?
  status            WorkspaceStatus    @default(ACTIVE)
  plan              Plan               @default(FREE)
  ownerId           String             @map("owner_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  aiRecommendations AIRecommendation[]
  aiUsage           AIUsage[]
  auditLogs         AuditLog[]
  brandProfile      BrandProfile?
  campaigns         Campaign[]
  memberships       Membership[]
  metaCampaigns     MetaCampaign[]
  socialAccounts    SocialAccount[]
  subscriptions     Subscription[]
  owner             User               @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([ownerId])
  @@index([status])
  @@map("workspaces")
}

model Membership {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  workspaceId String         @map("workspace_id")
  role        MembershipRole @default(MEMBER)
  joinedAt    DateTime       @default(now()) @map("joined_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@map("memberships")
}

model BrandProfile {
  id               String    @id @default(cuid())
  workspaceId      String    @unique @map("workspace_id")
  companyName      String    @map("company_name")
  website          String?
  description      String?
  mission          String?
  vision           String?
  values           String[]  @default([])
  toneOfVoice      String?   @map("tone_of_voice")
  targetAudience   Json?     @map("target_audience")
  brandColors      Json?     @map("brand_colors")
  logoUrl          String?   @map("logo_url")
  industry         String?
  competitors      String[]  @default([])
  hashtags         String[]  @default([])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  primaryGoal      String?   @map("primary_goal")
  budget           Decimal?  @db.Decimal(10, 2)
  location         String?
  productsServices String[]  @default([]) @map("products_services")
  lastAnalyzedAt   DateTime? @map("last_analyzed_at")
  analysisSummary  Json?     @map("analysis_summary")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([industry])
  @@map("brand_profiles")
}

model SocialAccount {
  id             String          @id @default(cuid())
  workspaceId    String          @map("workspace_id")
  platform       SocialPlatform
  accountName    String          @map("account_name")
  handle         String?
  profileUrl     String?         @map("profile_url")
  followerCount  Int?            @default(0) @map("follower_count")
  accessToken    String?         @map("access_token")
  refreshToken   String?         @map("refresh_token")
  tokenExpiresAt DateTime?       @map("token_expires_at")
  isConnected    Boolean         @default(false) @map("is_connected")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  publishedPosts PublishedPost[]
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([platform])
  @@index([isConnected])
  @@map("social_accounts")
}

model Campaign {
  id                      String                   @id @default(cuid())
  workspaceId             String                   @map("workspace_id")
  name                    String
  description             String?
  goal                    CampaignGoal
  status                  CampaignStatus           @default(DRAFT)
  budget                  Decimal?                 @db.Decimal(10, 2)
  startDate               DateTime?                @map("start_date")
  endDate                 DateTime?                @map("end_date")
  targetAudience          Json?                    @map("target_audience")
  platforms               SocialPlatform[]
  aiStrategy              Json?                    @map("ai_strategy")
  createdBy               String                   @map("created_by")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  offer                   String?
  notes                   String?
  aiStrategyPlan          Json?                    @map("ai_strategy_plan")
  generateVideo           Boolean                  @default(false) @map("generate_video")
  agentRuns               AgentRun[]
  aiJobs                  AIJob[]
  aiRecommendations       AIRecommendation[]
  analyticsSnapshots      AnalyticsSnapshot[]
  brandAnalysis           BrandAnalysis?
  campaignAnalytics       CampaignAnalytics[]
  campaignAssets          CampaignAsset[]
  campaignCopy            CampaignCopy?
  drafts                  CampaignDraft[]
  history                 CampaignHistory[]
  campaignPlatforms       CampaignPlatform[]
  campaignRecommendations CampaignRecommendation[]
  campaignStrategy        CampaignStrategy?
  creator                 User                     @relation("CampaignCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  competitorAnalysis      CompetitorAnalysis?
  creativeBrief           CreativeBrief?
  generatedAssets         GeneratedAsset[]
  generatedPosts          GeneratedPost[]
  learningInsights        LearningInsight[]
  metaCampaign            MetaCampaign?
  publishedPosts          PublishedPost[]
  publishingPlan          PublishingPlan?
  scheduledPosts          ScheduledPost[]

  @@index([workspaceId])
  @@index([status])
  @@index([createdBy])
  @@index([startDate, endDate])
  @@map("campaigns")
}

model CampaignPlatform {
  id         String         @id @default(cuid())
  campaignId String         @map("campaign_id")
  platform   SocialPlatform
  createdAt  DateTime       @default(now()) @map("created_at")
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, platform])
  @@index([campaignId])
  @@index([platform])
  @@map("campaign_platforms")
}

model AgentRun {
  id           String         @id @default(cuid())
  campaignId   String         @map("campaign_id")
  agentName    String         @map("agent_name")
  modelUsed    String         @map("model_used")
  input        Json
  output       Json?
  status       AgentRunStatus @default(PENDING)
  errorMessage String?        @map("error_message")
  retryCount   Int            @default(0) @map("retry_count")
  startedAt    DateTime?      @map("started_at")
  completedAt  DateTime?      @map("completed_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([agentName])
  @@index([status])
  @@index([createdAt])
  @@map("agent_runs")
}

model BrandAnalysis {
  id         String   @id @default(cuid())
  campaignId String   @unique @map("campaign_id")
  profile    Json
  summary    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("brand_analyses")
}

model CompetitorAnalysis {
  id            String   @id @default(cuid())
  campaignId    String   @unique @map("campaign_id")
  competitors   Json
  opportunities String[] @default([])
  summary       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("competitor_analyses")
}

model CampaignStrategy {
  id               String   @id @default(cuid())
  campaignId       String   @unique @map("campaign_id")
  strategy         Json
  contentCalendar  Json?    @map("content_calendar")
  budgetAllocation Json?    @map("budget_allocation")
  summary          String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_strategies")
}

model CampaignCopy {
  id         String   @id @default(cuid())
  campaignId String   @unique @map("campaign_id")
  copy       Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_copies")
}

model CreativeBrief {
  id          String   @id @default(cuid())
  campaignId  String   @unique @map("campaign_id")
  brief       Json
  imagePrompt String   @map("image_prompt")
  videoPrompt String   @map("video_prompt")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("creative_briefs")
}

model GeneratedAsset {
  id               String               @id @default(cuid())
  campaignId       String               @map("campaign_id")
  type             GeneratedAssetType
  status           GeneratedAssetStatus @default(PENDING)
  provider         String
  url              String?
  base64Ref        String?              @map("base64_ref")
  externalJobId    String?              @map("external_job_id")
  prompt           String?
  negativePrompt   String?              @map("negative_prompt")
  model            String?
  metadata         Json?
  providerResponse Json?                @map("provider_response")
  errorMessage     String?              @map("error_message")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  campaign         Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([type])
  @@index([status])
  @@index([externalJobId])
  @@map("generated_assets")
}

model PublishingPlan {
  id         String   @id @default(cuid())
  campaignId String   @unique @map("campaign_id")
  plan       Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("publishing_plans")
}

model CampaignDraft {
  id                   String     @id @default(cuid())
  campaignId           String     @map("campaign_id")
  version              Int        @default(1)
  name                 String
  primaryText          String     @map("primary_text")
  headline             String
  description          String
  callToAction         String     @map("call_to_action")
  instagramCaption     String     @map("instagram_caption")
  facebookCaption      String     @map("facebook_caption")
  hashtags             String[]
  pinterestTitle       String     @map("pinterest_title")
  pinterestDescription String     @map("pinterest_description")
  altText              String     @map("alt_text")
  creativeDirection    String     @map("creative_direction")
  status               PostStatus @default(GENERATED)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  campaign             Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@map("campaign_drafts")
}

model MetaCampaign {
  id          String      @id @default(cuid())
  campaignId  String      @unique @map("campaign_id")
  workspaceId String      @map("workspace_id")
  externalId  String?     @unique @map("external_id")
  objective   String
  status      String      @default("PAUSED")
  budget      Decimal?    @db.Decimal(10, 2)
  rawResponse Json?       @map("raw_response")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  adSets      MetaAdSet[]
  ads         MetaAd[]
  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@map("meta_campaigns")
}

model MetaAdSet {
  id             String       @id @default(cuid())
  metaCampaignId String       @map("meta_campaign_id")
  externalId     String?      @unique @map("external_id")
  name           String
  status         String       @default("PAUSED")
  dailyBudget    Decimal?     @map("daily_budget") @db.Decimal(10, 2)
  targeting      Json?
  rawResponse    Json?        @map("raw_response")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  metaCampaign   MetaCampaign @relation(fields: [metaCampaignId], references: [id], onDelete: Cascade)
  ads            MetaAd[]

  @@index([metaCampaignId])
  @@index([status])
  @@map("meta_ad_sets")
}

model MetaAd {
  id              String         @id @default(cuid())
  metaCampaignId  String         @map("meta_campaign_id")
  metaAdSetId     String?        @map("meta_ad_set_id")
  generatedPostId String?        @map("generated_post_id")
  externalId      String?        @unique @map("external_id")
  creativeId      String?        @map("creative_id")
  name            String
  status          String         @default("PAUSED")
  rawResponse     Json?          @map("raw_response")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  generatedPost   GeneratedPost? @relation(fields: [generatedPostId], references: [id])
  metaAdSet       MetaAdSet?     @relation(fields: [metaAdSetId], references: [id])
  metaCampaign    MetaCampaign   @relation(fields: [metaCampaignId], references: [id], onDelete: Cascade)

  @@index([metaCampaignId])
  @@index([metaAdSetId])
  @@index([generatedPostId])
  @@index([status])
  @@map("meta_ads")
}

model GeneratedPost {
  id            String         @id @default(cuid())
  campaignId    String         @map("campaign_id")
  platform      SocialPlatform
  contentType   ContentType
  title         String?
  body          String
  caption       String?
  hashtags      String[]
  mentions      String[]
  mediaUrls     String[]       @default([]) @map("media_urls")
  mediaType     MediaType?     @map("media_type")
  callToAction  String?        @map("call_to_action")
  aiConfidence  Float?         @map("ai_confidence")
  aiReasoning   String?        @map("ai_reasoning")
  status        PostStatus     @default(GENERATED)
  version       Int            @default(1)
  parentId      String?        @map("parent_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  adCampaignId  String?        @map("ad_campaign_id")
  adSetId       String?        @map("ad_set_id")
  adCreativeId  String?        @map("ad_creative_id")
  adId          String?        @map("ad_id")
  adStatus      String?        @map("ad_status")
  approvals     Approval[]
  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  metaAds       MetaAd[]
  publishedPost PublishedPost?
  scheduledPost ScheduledPost?

  @@index([campaignId])
  @@index([platform])
  @@index([status])
  @@index([contentType])
  @@index([adStatus])
  @@map("generated_posts")
}

model CampaignAsset {
  id               String    @id @default(cuid())
  campaignId       String    @map("campaign_id")
  name             String
  type             AssetType
  url              String
  thumbnailUrl     String?   @map("thumbnail_url")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  prompt           String?
  generationModel  String?   @map("generation_model")
  generationCost   Decimal?  @map("generation_cost") @db.Decimal(10, 6)
  providerResponse Json?     @map("provider_response")
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([type])
  @@map("campaign_assets")
}

model Approval {
  id         String         @id @default(cuid())
  postId     String         @map("post_id")
  reviewerId String         @map("reviewer_id")
  status     ApprovalStatus @default(PENDING_REVIEW)
  feedback   String?
  reviewedAt DateTime?      @map("reviewed_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  post       GeneratedPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([postId, reviewerId])
  @@index([postId])
  @@index([reviewerId])
  @@index([status])
  @@map("approvals")
}

model ScheduledPost {
  id            String         @id @default(cuid())
  postId        String         @unique @map("post_id")
  campaignId    String         @map("campaign_id")
  platform      SocialPlatform
  scheduledAt   DateTime       @map("scheduled_at")
  timezone      String         @default("UTC")
  status        ScheduleStatus @default(SCHEDULED)
  publishedAt   DateTime?      @map("published_at")
  errorMessage  String?        @map("error_message")
  retryCount    Int            @default(0) @map("retry_count")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  publishedPost PublishedPost?
  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  post          GeneratedPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([scheduledAt])
  @@index([status])
  @@index([platform])
  @@map("scheduled_posts")
}

model PublishedPost {
  id              String              @id @default(cuid())
  postId          String              @unique @map("post_id")
  scheduledPostId String?             @unique @map("scheduled_post_id")
  campaignId      String              @map("campaign_id")
  socialAccountId String              @map("social_account_id")
  platform        SocialPlatform
  externalId      String?             @map("external_id")
  externalUrl     String?             @map("external_url")
  publishedAt     DateTime            @default(now()) @map("published_at")
  status          PublishStatus       @default(PUBLISHED)
  errorMessage    String?             @map("error_message")
  metadata        Json?
  createdAt       DateTime            @default(now()) @map("created_at")
  analytics       AnalyticsSnapshot[]
  campaign        Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  post            GeneratedPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  scheduledPost   ScheduledPost?      @relation(fields: [scheduledPostId], references: [id])
  socialAccount   SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([socialAccountId])
  @@index([platform])
  @@index([publishedAt])
  @@map("published_posts")
}

model AnalyticsSnapshot {
  id               String         @id @default(cuid())
  campaignId       String         @map("campaign_id")
  publishedPostId  String?        @map("published_post_id")
  platform         SocialPlatform
  impressions      Int            @default(0)
  reach            Int            @default(0)
  engagement       Int            @default(0)
  likes            Int            @default(0)
  comments         Int            @default(0)
  shares           Int            @default(0)
  clicks           Int            @default(0)
  saves            Int            @default(0)
  videoViews       Int            @default(0) @map("video_views")
  watchTime        Int            @default(0) @map("watch_time")
  followerGrowth   Int            @default(0) @map("follower_growth")
  ctr              Float?         @map("click_through_rate")
  cpc              Decimal?       @map("cost_per_click") @db.Decimal(10, 4)
  demographics     Json?
  topHashtags      Json?          @map("top_hashtags")
  bestPostTime     String?        @map("best_post_time")
  aiInsights       String?        @map("ai_insights")
  snapshotDate     DateTime       @default(now()) @map("snapshot_date")
  createdAt        DateTime       @default(now()) @map("created_at")
  providerResponse Json?          @map("provider_response")
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  publishedPost    PublishedPost? @relation(fields: [publishedPostId], references: [id])

  @@index([campaignId])
  @@index([publishedPostId])
  @@index([platform])
  @@index([snapshotDate])
  @@index([campaignId, snapshotDate])
  @@map("analytics_snapshots")
}

model CampaignAnalytics {
  id               String   @id @default(cuid())
  campaignId       String   @map("campaign_id")
  spend            Decimal  @default(0) @db.Decimal(12, 2)
  reach            Int      @default(0)
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  ctr              Float?
  cpm              Decimal? @db.Decimal(10, 4)
  cpc              Decimal? @db.Decimal(10, 4)
  frequency        Float?
  conversions      Int      @default(0)
  roas             Float?
  engagement       Int      @default(0)
  comments         Int      @default(0)
  shares           Int      @default(0)
  likes            Int      @default(0)
  source           String   @default("meta")
  providerResponse Json?    @map("provider_response")
  snapshotDate     DateTime @default(now()) @map("snapshot_date")
  createdAt        DateTime @default(now()) @map("created_at")
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, snapshotDate])
  @@index([source])
  @@map("campaign_analytics")
}

model CampaignRecommendation {
  id             String   @id @default(cuid())
  campaignId     String   @map("campaign_id")
  summary        String
  recommendation String
  metric         String?
  severity       String   @default("info")
  status         String   @default("open")
  source         String   @default("rule_based")
  createdAt      DateTime @default(now()) @map("created_at")
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([status])
  @@index([severity])
  @@map("campaign_recommendations")
}

model LearningInsight {
  id              String   @id @default(cuid())
  campaignId      String   @map("campaign_id")
  summary         String
  recommendations String[]
  output          Json
  createdAt       DateTime @default(now()) @map("created_at")
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@map("learning_insights")
}

model CampaignHistory {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  userId     String?  @map("user_id")
  action     String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([campaignId, createdAt])
  @@index([userId])
  @@index([action])
  @@map("campaign_history")
}

model AIJob {
  id          String      @id @default(cuid())
  campaignId  String      @map("campaign_id")
  agentType   AIAgentType @map("agent_type")
  status      AIJobStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?
  tokensUsed  Int         @default(0) @map("tokens_used")
  cost        Decimal?    @db.Decimal(10, 6)
  duration    Int?
  startedAt   DateTime?   @map("started_at")
  completedAt DateTime?   @map("completed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([agentType])
  @@index([status])
  @@index([createdAt])
  @@map("ai_jobs")
}

model AIUsage {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  workspaceId String      @map("workspace_id")
  agentType   AIAgentType @map("agent_type")
  tokensUsed  Int         @default(0) @map("tokens_used")
  cost        Decimal?    @db.Decimal(10, 6)
  model       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("ai_usage")
}

model AIRecommendation {
  id                  String    @id @default(cuid())
  campaignId          String    @map("campaign_id")
  workspaceId         String    @map("workspace_id")
  summary             String
  wins                String[]
  opportunities       String[]
  nextExperiments     String[]  @map("next_experiments")
  sourceSnapshotCount Int       @default(0) @map("source_snapshot_count")
  createdAt           DateTime  @default(now()) @map("created_at")
  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("ai_recommendations")
}

model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @map("workspace_id")
  stripeCustomerId     String             @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  status               SubscriptionStatus @default(INCOMPLETE)
  plan                 Plan
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([stripeCustomerId])
  @@index([status])
  @@map("subscriptions")
}

model AuditLog {
  id          String      @id @default(cuid())
  workspaceId String?     @map("workspace_id")
  userId      String?     @map("user_id")
  action      AuditAction
  entityType  String      @map("entity_type")
  entityId    String?     @map("entity_id")
  details     Json?
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")
  user        User?       @relation(fields: [userId], references: [id])
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

